# ==============================================================================
# OZER Detail Studio - Environment Variables Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Twilio SMS Configuration (US +1)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15125550199

# ------------------------------------------------------------------------------
# Google Calendar API Integration (Service Account)
# ------------------------------------------------------------------------------
# The Calendar ID to sync with (e.g. your shop email or primary calendar ID)
GOOGLE_CALENDAR_ID=your_shop_calendar_id@group.calendar.google.com
# Google Cloud Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=ozer-calendar-sync@your-gcp-project.iam.gserviceaccount.com
# Google Cloud Service Account Private Key (replace literal \n with actual newlines or escaped string)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Google Places Reviews
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=your-google-place-id

# ------------------------------------------------------------------------------
# Business Defaults (Austin, TX)
# ------------------------------------------------------------------------------
BUSINESS_TIMEZONE=America/Chicago
